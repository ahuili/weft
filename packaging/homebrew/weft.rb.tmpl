cask "weft" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "https://github.com/{{OWNER}}/{{REPO}}/releases/download/v#{version}/Weft-#{version}.zip"
  name "Weft"
  desc "Window workbench: per-display scenes, stage layouts and pinyin window switching"
  homepage "https://github.com/{{OWNER}}/{{REPO}}"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: :sonoma

  app "Weft.app"

  # 还没有 Apple 公证：去掉隔离标记，否则 macOS 会拦着不让打开
  weft_app = "#{appdir}/Weft.app"
  # Homebrew 7 起用 postflight_steps；更早的版本没有它，只认 postflight 块
  if respond_to?(:postflight_steps)
    postflight_steps do
      run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", weft_app], must_succeed: false
    end
  else
    postflight do
      system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", weft_app], must_succeed: false
    end
  end

  uninstall quit: "{{BUNDLE_ID}}"

  zap trash: [
    "~/Library/Application Support/Weft",
    "~/Library/Preferences/{{BUNDLE_ID}}.plist",
  ]

  caveats <<~EOS
    Weft 需要「辅助功能」权限（必需）和「录屏」权限（只用来画窗口缩略图）。
    第一次打开会有引导；之后在 系统设置 › 隐私与安全性 里也能改。
  EOS
end
